# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── Build output ───────────────────────────────────────────────────────────────
client/dist/
client/dist-ssr/

# ── Environment variables (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.*.local
server/.env

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/

# ── Uploads (user-generated files) ───────────────────────────────────────────
server/uploads/avatars/*
server/uploads/documents/*
!server/uploads/avatars/.gitkeep
!server/uploads/documents/.gitkeep
