# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/airport_management

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_openssl_rand_hex_64
JWT_EXPIRE=7d

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Option A (recommended): host/port SMTP (Mailtrap / SES / Postmark / etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
FROM_EMAIL=noreply@aeromanage.com
FROM_NAME=AeroManage

# Option B: service-based SMTP (e.g., Gmail). If using this, you can omit SMTP_HOST.
# SMTP_SERVICE=gmail

# ─── Frontend ─────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
