# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
# Get your connection string from: https://cloud.mongodb.com → Connect → Drivers
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/airport_management?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/airport_management?retryWrites=true&w=majority&appName=AeroManage

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_openssl_rand_hex_64
JWT_EXPIRE=7d

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
FROM_EMAIL=noreply@aeromanage.com
FROM_NAME=AeroManage

# ─── Frontend ─────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
